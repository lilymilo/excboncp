# ExcbonCP Central Server Configuration
# Copy to .env and fill in values. NEVER commit .env to Git.
#
# Quick setup:
#   cp .env.example .env
#   python3 scripts/generate-secrets.py   # Copy output into .env

# === REQUIRED SECRETS ===
# Generate JWT secret: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Generate encryption key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# === SERVER ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === DATABASE ===
DATABASE_PATH=./data/excboncp.db

# === RATE LIMITING ===
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10

# === TLS (for production) ===
# TLS_CERT_PATH=
# TLS_KEY_PATH=

# === MQTT (future) ===
# MQTT_BROKER_HOST=localhost
# MQTT_BROKER_PORT=1883

# === BLOCKCHAIN (future) ===
# BASE_SEPOLIA_RPC_URL=
# EAS_CONTRACT_ADDRESS=

# === SATELLITE (future) ===
# SATELLITE_API_KEY=
# SATELLITE_API_URL=
