# ExcbonCP Central Server & IoT Configuration
# Copy to .env and fill in values. NEVER commit .env to Git.

# === REQUIRED SECRETS ===
# Generate JWT secret: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Generate encryption key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# === SERVER ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === DATABASE ===
DATABASE_PATH=./data/excboncp.db

# === DEMO SEED (simulation only) ===
# SEED_DEMO_PASSWORD=

# === RATE LIMITING ===
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10

# === MQTT & IOT ===
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC_TELEMETRY=CbonCP/node-1/telemetry
MQTT_TOPIC_SUBSCRIPTION=CbonCP/+/telemetry
IOT_GATEWAY_PORT=5050
SIMULATION_MODE=false
SIMULATION_INTERVAL_MS=5000

# === EAS / BLOCKCHAIN (Day 3, Base Sepolia) ===
# EVM_PRIVATE_KEY must contain ONLY the private key (0x + 64 hex chars),
# no extra text or quotes. Leave empty to force simulation mode.
EVM_PRIVATE_KEY=
EVM_RPC_URL=https://base-sepolia.infura.io/v3/YOUR_API_KEY
EVM_RPC_URL_PUBLIC=https://sepolia.base.org
EAS_SCHEMA_REGISTRY=0x4200000000000000000000000000000000000020
EAS_ADDRESS=0x4200000000000000000000000000000000000021
EVM_CHAIN_ID=84532
# true = local simulation (no gas, no testnet funds required)
EVM_SIMULATION_MODE=true
AUDITOR_USERNAME=auditor_demo

# === SATELLITE (future) ===
# SATELLITE_API_KEY=
# SATELLITE_API_URL=

EAS_SCHEMA_UID=0x64e443d45df4a77a844017cbf7c08d315f93f55dce247c083ebfa75686e37996
