# =============================================================================
# CbonCP - IoT Node Environment Configuration
# Copy this file to .env: cp .env.example .env
# =============================================================================

# --- MQTT Broker -------------------------------------------------------------
MQTT_BROKER=mqtt-broker
MQTT_PORT=1883
MQTT_TOPIC_TELEMETRY=CbonCP/node-1/telemetry
MQTT_TOPIC_SUBSCRIPTION=CbonCP/+/telemetry

# --- IoT Gateway Service -----------------------------------------------------
NODE_ENV=production
IOT_GATEWAY_PORT=5050
SIMULATION_MODE=false
SIMULATION_INTERVAL_MS=5000

