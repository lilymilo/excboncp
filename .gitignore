# ===========================
# ExcbonCP .gitignore
# ===========================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
pip-wheel-metadata/

# === Node.js ===
node_modules/
.next/
dist/
build/
*.tsbuildinfo

# === Environment ===
.env
.env.local
.env.*.local
# Keep the example
!.env.example

# === IDE ===
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath

# === Data ===
*.db
*.sqlite
*.sqlite3
data/
!data/.gitkeep

# === OS ===
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# === Docker ===
docker-compose.override.yml

# === Credentials & Secrets ===
*.pem
*.key
*.crt
credentials.json
secrets.json
*.p12

# === Logs ===
logs/
*.log

# === Testing ===
.coverage
htmlcov/
.pytest_cache/
coverage.xml
*.cover
.hypothesis/

# === PlatformIO (IoT firmware) ===
.pio/
.pioenvs/
.piolibdeps/

# === Misc ===
tmp/
scratch/
*.bak
*.tmp
backups/
