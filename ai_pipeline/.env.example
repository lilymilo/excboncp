# MQTT Broker Configuration
# Gunakan broker.emqx.io jika teman menggunakan simulator web (Wokwi).
# Gunakan localhost atau IP lokal jika menggunakan Mosquitto lokal/Docker.
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=CbonCP/node-1/telemetry
MQTT_KEEPALIVE=60
MQTT_USERNAME=
MQTT_PASSWORD=

# Google Earth Engine (GEE) Configuration
GEE_PROJECT_ID=cboncp
GEE_SERVICE_ACCOUNT_EMAIL=cboncp-gee-sa@cboncp.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=service_account.json

# Monitoring Coordinates & Anomaly Thresholds
# Default to Bogor Conservation Forest (Hutan Lindung Bogor)
DEFAULT_MONITOR_LAT=-6.5971
DEFAULT_MONITOR_LON=106.7994
TEMP_ANOMALY_THRESHOLD=30.0
GEE_SEARCH_DAYS=14
GEE_MAX_CLOUD_PERCENTAGE=20

